API_PORT=4000
# 127.0.0.1 limita el acceso a esta computadora. 0.0.0.0 lo abre a toda la red:
# la aplicación NO tiene autenticación, así que solo con un cortafuegos delante.
HOST=127.0.0.1
AI_PROVIDER=lmstudio

# Ollama (AI_PROVIDER=ollama) — el proveedor local de un servidor sin escritorio.
# OLLAMA_MODEL debe ser el id EXACTO, con su tag, que devuelve /v1/models:
#   curl -s http://127.0.0.1:11434/v1/models | jq -r '.data[].id'
OLLAMA_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.1:8b

# LM Studio (AI_PROVIDER=lmstudio) — el proveedor local de escritorio.
LM_STUDIO_URL=http://localhost:1234/v1
LM_STUDIO_MODEL=openai/gpt-oss-20b

# OpenRouter (AI_PROVIDER=openrouter) SACA EL TEXTO DE LA PROPUESTA DE ESTA
# MÁQUINA. Requiere autorización institucional y revisión de privacidad.
OPENROUTER_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-20b
OPENROUTER_APP_NAME=RCM Research Paper Checker
# OPENROUTER_SITE_URL=https://example.edu
